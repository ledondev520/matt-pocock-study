# Example nginx snippet: forward only POST /api/ask to the matt-ask process.
# http {} level (e.g. conf.d/matt-ask-limit.conf): a coarse flood guard, looser than the app's
# own limits (10 per IP per minute, 100 per IP per day, 1000 model calls per day site-wide).
limit_req_zone $binary_remote_addr zone=matt_ask:10m rate=20r/m;

# Inside the site's server {} block, before `location /`:
location = /api/ask {
    limit_req zone=matt_ask burst=10 nodelay;
    limit_req_status 429;
    limit_except POST { deny all; }
    client_max_body_size 4k;
    proxy_pass http://127.0.0.1:8788;
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    # The app trusts this header only because the peer is loopback. Behind Cloudflare, configure
    # real_ip first (set_real_ip_from <Cloudflare ranges>; real_ip_header CF-Connecting-IP;) so
    # $remote_addr is the visitor, never a client-supplied header.
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For "";
    proxy_set_header Connection "";
    proxy_read_timeout 30s;
}
# Nothing else under /api/ask/ is forwarded; /healthz is reachable on loopback only.
