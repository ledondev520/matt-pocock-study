#!/bin/bash
# Root-side release switcher for matt.withkeya.com (installed as /usr/local/sbin/matt-release,
# owned by root, mode 755). The deploy user may run only this file through sudo; every argument
# is validated again here because this is the privilege boundary.
#
#   matt-release activate <commit-sha-40>     unpack incoming/<sha>.tar.gz into a new release,
#                                             switch `current`, restart, health-check; on failure
#                                             switch back and exit 1
#   matt-release rollback <current-release>   switch to the newest earlier good release
#   matt-release status                       print release=<name> commit=<sha>
#
# Release directories: releases/<UTCYYYYmmdd-HHMMSS>-<sha12>. Only names in that exact form are
# pruned (newest 5 kept, plus whatever is current); hand-made releases are never deleted.
set -euo pipefail
umask 022
export LC_ALL=C PATH=/usr/sbin:/usr/bin:/sbin:/bin

readonly ROOT=/srv/matt-site
readonly RELEASES=$ROOT/releases
readonly INCOMING=$ROOT/incoming
readonly STATE=$ROOT/deploy-state
readonly SERVICE=matt-site
readonly RUN_USER=mattsite
readonly HEALTH_URL=http://127.0.0.1:8787/api/health
readonly KEEP=5
readonly NEW_NAME='^[0-9]{8}-[0-9]{6}-[0-9a-f]{12}$'
# Older hand-made releases look like 20261022-1548-3af3984; they are valid rollback targets.
readonly ANY_NAME='^[0-9]{8}-[0-9]{4,6}-[0-9a-f]{7,40}$'

die() { echo "matt-release: $*" >&2; exit 2; }
log() { echo "matt-release: $*" >&2; }

[ "$(id -u)" -eq 0 ] || die "must run as root"
install -d -m 700 "$STATE"
exec 8>"$STATE/lock"
flock -w 600 8 || die "another deploy is running"

current_name() {
  local target
  target=$(readlink -- "$ROOT/current") || return 1
  target=${target#releases/}
  [[ $target =~ $ANY_NAME ]] || return 1
  printf '%s\n' "$target"
}

# A release name is usable only if it is a real directory directly under releases/.
valid_release() {
  local name=$1
  [[ $name =~ $ANY_NAME ]] || return 1
  if [ ! -d "$RELEASES/$name" ] || [ -L "$RELEASES/$name" ]; then return 1; fi
  [ "$(realpath -e -- "$RELEASES/$name")" = "$(realpath -e -- "$RELEASES")/$name" ]
}

switch_to() {
  local name=$1
  valid_release "$name" || die "not a release: $name"
  ln -sfn -- "releases/$name" "$ROOT/current.new"
  mv -Tf -- "$ROOT/current.new" "$ROOT/current"
  printf '%s\n' "$name" >> "$STATE/history"
  systemctl restart "$SERVICE"
}

healthy() {
  local _
  for _ in $(seq 1 30); do
    if curl -fsS --max-time 3 "$HEALTH_URL" 2>/dev/null | grep -q '"ok":true'; then return 0; fi
    sleep 1
  done
  return 1
}

mark_failed() { printf '%s\n' "$1" >> "$STATE/failed"; }

# Newest release in the activation history that is not current, not failed and still on disk.
previous_good() {
  local cur=$1 name
  [ -s "$STATE/history" ] || return 1
  while IFS= read -r name; do
    [ "$name" = "$cur" ] && continue
    [ -s "$STATE/failed" ] && grep -qxF -- "$name" "$STATE/failed" && continue
    valid_release "$name" || continue
    printf '%s\n' "$name"; return 0
  done < <(tac -- "$STATE/history")
  return 1
}

prune() {
  local cur=$1 name n=0
  while IFS= read -r name; do
    [[ $name =~ $NEW_NAME ]] || continue
    n=$((n + 1))
    [ "$n" -le "$KEEP" ] && continue
    [ "$name" = "$cur" ] && continue
    valid_release "$name" || continue
    log "pruning $name"
    rm -rf --one-file-system -- "${RELEASES:?}/$name"
  done < <(find "$RELEASES" -mindepth 1 -maxdepth 1 -type d -printf '%f\n' | sort -r)
}

unpack() {
  local tarball=$1 dest=$2
  python3 - "$tarball" "$dest" <<'PY'
import os, sys, tarfile
src, dest = sys.argv[1], sys.argv[2]
if not hasattr(tarfile, "data_filter"):
    sys.exit("python3 tarfile has no extraction filters; refusing to unpack")
fd = os.open(src, os.O_RDONLY | os.O_NOFOLLOW)
with os.fdopen(fd, "rb") as fh, tarfile.open(fileobj=fh, mode="r:gz") as tar:
    # "data" refuses absolute paths, "..", links leaving dest, devices, and setuid bits.
    tar.extractall(dest, filter="data")
PY
}

cmd_activate() {
  local sha=$1 tarball name stage old
  [[ $sha =~ ^[0-9a-f]{40}$ ]] || die "bad commit sha"
  tarball=$INCOMING/$sha.tar.gz
  if [ ! -f "$tarball" ] || [ -L "$tarball" ]; then die "no upload for $sha"; fi
  name=$(date -u +%Y%m%d-%H%M%S)-${sha:0:12}
  stage=$RELEASES/.staging-$name
  old=$(current_name) || die "current does not point at a release; fix by hand first"
  [ -s "$STATE/history" ] || printf '%s\n' "$old" > "$STATE/history"

  rm -rf -- "$stage"; install -d -m 700 "$stage"
  if ! unpack "$tarball" "$stage"; then rm -rf -- "$stage" "$tarball"; die "unpack failed"; fi
  rm -f -- "$tarball"
  [ "$(cat -- "$stage/DEPLOYED_COMMIT" 2>/dev/null)" = "$sha" ] || { rm -rf -- "$stage"; die "DEPLOYED_COMMIT does not match"; }
  if [ ! -f "$stage/package.json" ] || [ ! -d "$stage/dist" ] || [ ! -d "$stage/node_modules" ]; then
    rm -rf -- "$stage"; die "release is incomplete"
  fi
  install -d "$stage/generated"
  chown -R root:root -- "$stage"
  chmod -R a+rX,go-w -- "$stage"
  chown -R "$RUN_USER:$RUN_USER" -- "$stage/dist" "$stage/generated"
  chmod 755 -- "$stage"
  mv -T -- "$stage" "$RELEASES/$name"

  log "switching $old -> $name"
  switch_to "$name"
  if ! healthy; then
    log "health check failed; switching back to $old"
    mark_failed "$name"
    switch_to "$old"
    healthy || log "WARNING: $old is not healthy either"
    exit 1
  fi
  prune "$name"
  echo "release=$name"
  echo "previous=$old"
}

cmd_rollback() {
  local expected=$1 cur target
  [[ $expected =~ $ANY_NAME ]] || die "bad release name"
  cur=$(current_name) || die "current does not point at a release"
  [ "$cur" = "$expected" ] || die "current is $cur, not $expected; refusing"
  target=$(previous_good "$cur") || die "no earlier good release to roll back to"
  log "rolling back $cur -> $target"
  mark_failed "$cur"
  switch_to "$target"
  healthy || { log "WARNING: $target is not healthy after rollback"; exit 1; }
  echo "release=$target"
  echo "previous=$cur"
}

cmd_status() {
  local cur commit
  cur=$(current_name) || die "current does not point at a release"
  commit=$(cat -- "$RELEASES/$cur/DEPLOYED_COMMIT" 2>/dev/null || echo unknown)
  [[ $commit =~ ^[0-9a-f]{7,40}$ ]] || commit=unknown
  echo "release=$cur"
  echo "commit=$commit"
}

case ${1:-} in
  activate) [ $# -eq 2 ] || die "usage: activate <sha>"; cmd_activate "$2" ;;
  rollback) [ $# -eq 2 ] || die "usage: rollback <current-release>"; cmd_rollback "$2" ;;
  status)   [ $# -eq 1 ] || die "usage: status"; cmd_status ;;
  *) die "usage: activate <sha> | rollback <current-release> | status" ;;
esac
