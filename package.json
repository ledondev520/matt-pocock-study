{
  "name": "matt-study-notes",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20.19.0 <21"
  },
  "scripts": {
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run && node --test test/corpus/",
    "build:content": "tsx scripts/build-content.ts",
    "build": "npm run build:content && vite build",
    "start": "tsx server/index.ts",
    "dev": "npm run build:content && concurrently -k \"tsx watch --include 'content/**/*.md' server/index.ts --dev\" \"vite --host 0.0.0.0\"",
    "corpus:x": "node scripts/corpus/fetch-x.mjs",
    "corpus:github": "node scripts/corpus/fetch-github.mjs",
    "corpus:aihero": "node scripts/corpus/fetch-aihero.mjs",
    "corpus:build": "node scripts/corpus/build-index.mjs",
    "corpus:summaries": "node scripts/corpus/apply-summaries.mjs",
    "check:overlap": "node scripts/check-overlap.mjs"
  },
  "dependencies": {
    "@hono/node-server": "^1.19.0",
    "@radix-ui/react-slot": "^1.2.3",
    "better-sqlite3": "12.4.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "hono": "^4.10.0",
    "marked": "^16.4.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "tailwind-merge": "^3.3.1",
    "yaml": "^2.8.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.0",
    "@tailwindcss/vite": "^4.1.16",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^20.19.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.1.0",
    "concurrently": "^9.2.1",
    "eslint": "^9.39.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "globals": "^16.4.0",
    "tailwindcss": "^4.1.16",
    "tsx": "^4.20.6",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.46.0",
    "vite": "^7.1.12",
    "vitest": "^4.1.12"
  },
  "license": "MIT"
}
