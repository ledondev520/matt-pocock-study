{
  "name": "matt-study-notes",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20.19.0 <21"
  },
  "scripts": {
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run && node --test test/corpus/ && npm run contrast",
    "build:content": "tsx scripts/build-content.ts",
    "build": "npm run build:content && npm run og && vite build && tsx scripts/static.tsx",
    "start": "tsx server/index.ts",
    "dev": "npm run build:content && concurrently -k \"tsx watch --include 'content/**/*.md' server/index.ts --dev\" \"vite --host localhost\"",
    "corpus:x": "node scripts/corpus/fetch-x.mjs",
    "corpus:github": "node scripts/corpus/fetch-github.mjs",
    "corpus:aihero": "node scripts/corpus/fetch-aihero.mjs",
    "corpus:build": "node scripts/corpus/build-index.mjs",
    "corpus:summaries": "node scripts/corpus/apply-summaries.mjs",
    "check:overlap": "node scripts/check-overlap.mjs",
    "contrast": "node scripts/contrast.mjs",
    "og": "tsx scripts/og.mjs",
    "import:art": "node scripts/import-art.mjs",
    "review": "node scripts/review.mjs",
    "diagrams": "node scripts/diagrams/build.mjs"
  },
  "dependencies": {
    "@fontsource/inter": "^5.3.0",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@fontsource/noto-sans-sc": "^5.3.1",
    "@fontsource/space-grotesk": "^5.3.0",
    "@hono/node-server": "^1.19.0",
    "@radix-ui/react-slot": "^1.2.3",
    "@resvg/resvg-js": "^2.6.2",
    "better-sqlite3": "12.4.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "hono": "^4.10.0",
    "lucide-react": "^0.468.0",
    "marked": "^16.4.0",
    "prism-react-renderer": "^2.4.1",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "tailwind-merge": "^3.3.1",
    "yaml": "^2.8.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.0",
    "@playwright/test": "^1.64.1",
    "@tailwindcss/vite": "^4.1.16",
    "@types/better-sqlite3": "^7.6.13",
    "@types/jsdom": "^30.0.0",
    "@types/node": "^20.19.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.1.0",
    "concurrently": "^9.2.1",
    "eslint": "^9.39.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "globals": "^16.4.0",
    "jsdom": "^29.1.1",
    "parse5": "^8.0.1",
    "saxes": "^6.0.0",
    "tailwindcss": "^4.1.16",
    "tsx": "^4.20.6",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.46.0",
    "vite": "^7.1.12",
    "vitest": "^4.1.12"
  },
  "license": "MIT"
}
