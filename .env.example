# Required for X API access; supply through your shell or secret manager.
X_BEARER_TOKEN=
# Optional public X handle; the script has a default.
X_HANDLE=
# Optional public GitHub user; the script has a default.
GH_USER=
# Optional GitHub API authentication; never commit a populated value.
GITHUB_TOKEN=
# Optional raw output directory; defaults to .corpus-raw/.
CORPUS_RAW_DIR=
# Public origin used for absolute links (llms.txt, canonical, og:url). Default https://matt.withkeya.com
SITE_URL=
# HTTP port for `npm start` (default 8787).
PORT=
# HTTP listen address for `npm start` (default 127.0.0.1).
HOST=
# --- /api/ask (server/ask/index.ts) ---
# Model API key; set only in the service environment, never in a file in this repository.
DEEPSEEK_API_KEY=
# 1 turns model answers on (also needs the key). Default off.
ASK_ENABLED=
# Loopback only: 127.0.0.1 (default) or ::1. Port default 8788.
ASK_HOST=
ASK_PORT=
# Defaults: https://api.deepseek.com, deepseek-flash.
DEEPSEEK_BASE_URL=
DEEPSEEK_MODEL=
# SQLite file for counters and the answer cache (default generated/ask.sqlite).
ASK_DB=
# Build-time index (default server-data/ask-index.json).
ASK_INDEX=
# Optional, server-side only: directory with matt-posts-<year>.jsonl; methodology chunks file.
ASK_DATASET_DIR=
ASK_CHUNKS_FILE=
# Limits (defaults 10, 100, 1000, 300 characters, 4 concurrent calls, 7 days).
ASK_PER_IP_PER_MINUTE=
ASK_PER_IP_PER_DAY=
ASK_GLOBAL_PER_DAY=
ASK_MAX_INPUT_CHARS=
ASK_MAX_CONCURRENT=
ASK_CACHE_DAYS=
# Upstream timeout (default 15000 ms); breaker opens after N consecutive failures for M ms (5, 300000).
ASK_TIMEOUT_MS=
ASK_BREAKER_FAILURES=
ASK_BREAKER_COOLDOWN_MS=
# Retrieval: minimum BM25 score to call the model (default 6) and passages per question (8).
ASK_MIN_SCORE=
ASK_CONTEXT_UNITS=
